@using KimiaFaravar.Application.Inventory
@using KimiaFaravar.Application.Security
@model KimiaFaravar.Web.Models.CatalogPageViewModel
@{
    ViewData["Title"] = "مدیریت کالا و گروه‌ها";
    var groupMap = Model.Data.Groups.ToDictionary(group => group.Id);
    string GroupPath(ProductGroupDto group)
    {
        var names = new Stack<string>();
        var current = group;
        var visited = new HashSet<long>();
        while (visited.Add(current.Id))
        {
            names.Push(current.Name);
            if (current.ParentId is not long parentId || !groupMap.TryGetValue(parentId, out var parent)) break;
            current = parent;
        }
        return string.Join(" / ", names);
    }
    int GroupDepth(ProductGroupDto group)
    {
        var depth = 0;
        var current = group;
        var visited = new HashSet<long>();
        while (visited.Add(current.Id) && current.ParentId is long parentId && groupMap.TryGetValue(parentId, out var parent))
        {
            depth++;
            current = parent;
        }
        return depth;
    }
    var groups = Model.Data.Groups.OrderBy(GroupPath).ToArray();
    var specifications = Model.Data.Specifications.OrderBy(item => item.Name).ToArray();
    var canManageGroups = User.HasClaim("permission", PermissionCodes.ProductGroupsManage);
    var canManageProducts = User.HasClaim("permission", PermissionCodes.ProductsManage);
    var canManageSpecifications = User.HasClaim("permission", PermissionCodes.SpecificationsManage);
    var firstTab = canManageProducts ? "new-product" : canManageGroups ? "groups" : "catalog-view";
}
<div class="container py-4" dir="rtl">
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-center mb-4">
        <div><h1 class="h3 fw-bold mb-1">کالاها و گروه‌بندی منابع</h1><p class="text-muted mb-0">ساختار درختی گروه‌ها، سطح نمایش فروش و مشخصات اختصاصی کالا</p></div>
        <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-primary">بازگشت به انبار</a>
    </div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

    <ul class="nav nav-pills mb-3 gap-2" role="tablist">
        @if (canManageProducts) { <li class="nav-item"><button class="nav-link @(firstTab == "new-product" ? "active" : "")" data-bs-toggle="pill" data-bs-target="#new-product" type="button">ثبت کالای جدید</button></li> }
        <li class="nav-item"><button class="nav-link @(firstTab == "groups" ? "active" : "")" data-bs-toggle="pill" data-bs-target="#groups" type="button">درخت گروه‌ها</button></li>
        @if (canManageSpecifications) {
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#new-spec" type="button">مشخصات</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#new-option" type="button">گزینه‌های مشخصات</button></li>
        }
        @if (!canManageProducts && !canManageGroups) { <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#catalog-view" type="button">کالاهای قابل نمایش</button></li> }
    </ul>

    <div class="tab-content">
        @if (canManageProducts) {
        <section class="tab-pane fade @(firstTab == "new-product" ? "show active" : "")" id="new-product">
            <div class="card shadow-sm border-0"><div class="card-body p-4">
                <h2 class="h5 mb-3">ثبت کالای جدید</h2>
                <p class="text-muted small">گروه را انتخاب کنید؛ مشخصات گروه و تمام والدهای آن خودکار نمایش داده می‌شوند.</p>
                <form asp-action="CreateProduct" method="post" id="product-form">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label" for="product-group">گروه کالا</label><select id="product-group" name="productGroupId" class="form-select" required><option value="">انتخاب گروه...</option>@foreach (var group in groups) { <option value="@group.Id">@GroupPath(group) (@group.Code)</option> }</select></div>
                        <div class="col-md-6"><label class="form-label" for="product-name">نام کالا</label><input id="product-name" name="name" class="form-control" maxlength="200" required /></div>
                        <div class="col-md-6"><label class="form-label" for="product-sku">کد یکتا / SKU</label><input id="product-sku" name="sku" class="form-control" maxlength="80" required dir="ltr" /></div>
                        <div class="col-md-6"><label class="form-label" for="product-unit">واحد پایه</label><select id="product-unit" name="baseUnit" class="form-select"><option>عدد</option><option>کیلوگرم</option><option>گرم</option><option>متر</option><option>سانتی‌متر</option><option>کارتن</option><option>بسته</option><option>رول</option></select></div>
                    </div>
                    <hr class="my-4" /><h3 class="h6 fw-bold">مشخصات اختصاصی کالا</h3>
                    <div class="row g-3 mt-1" id="dynamic-specifications" aria-live="polite"><p class="text-muted">برای نمایش مشخصات، گروه را انتخاب کنید.</p></div>
                    <input type="hidden" name="valuesJson" id="product-values-json" /><div id="product-form-error" class="alert alert-danger mt-3 d-none" role="alert"></div>
                    <button type="submit" class="btn btn-primary btn-lg mt-4 px-5">ثبت کالا</button>
                </form>
            </div></div>
        </section> }

        <section class="tab-pane fade @(firstTab == "groups" ? "show active" : "")" id="groups">
            @if (canManageGroups) {
            <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4">
                <h2 class="h5">تعریف گروه یا زیرگروه</h2>
                <form asp-action="CreateGroup" method="post" class="row g-3">
                    <div class="col-md-4"><label class="form-label">نام گروه</label><input name="name" class="form-control" required /></div>
                    <div class="col-md-4"><label class="form-label">کد گروه</label><input name="code" class="form-control" dir="ltr" required /></div>
                    <div class="col-md-4"><label class="form-label">گروه والد</label><select name="parentId" class="form-select"><option value="">گروه اصلی</option>@foreach (var group in groups) { <option value="@group.Id">@GroupPath(group)</option> }</select></div>
                    <div class="col-12"><div class="border rounded-3 p-3 bg-body-tertiary"><div class="fw-semibold mb-2">قابل نمایش برای</div><div class="d-flex flex-wrap gap-4">
                        <label class="form-check"><input name="visibleToInternalSales" value="true" class="form-check-input" type="checkbox" /><span class="form-check-label">فروش داخلی</span></label>
                        <label class="form-check"><input name="visibleToMarketDistribution" value="true" class="form-check-input" type="checkbox" /><span class="form-check-label">فروش و توزیع بازار</span></label>
                    </div><div class="form-text">اگر هیچ‌کدام انتخاب نشود، گروه فقط برای مدیرعامل و مدیر انبار قابل مشاهده است.</div></div></div>
                    <div class="col-12"><button class="btn btn-primary">ثبت گروه</button></div>
                </form>
            </div></div> }
            <div class="card border-0 shadow-sm"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">ساختار درختی گروه‌ها</h2><span class="text-muted small">@groups.Length گروه</span></div>
                <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>گروه</th><th>والد</th><th>کد</th><th>سطح نمایش</th></tr></thead><tbody>
                @foreach (var group in groups) {
                    var depth = GroupDepth(group); var parentName = group.ParentId is long parentId && groupMap.TryGetValue(parentId, out var parent) ? parent.Name : "گروه اصلی";
                    <tr><td><div class="d-flex align-items-center" style="padding-right:@(depth * 1.5)rem"><span class="text-primary ms-2">@(depth == 0 ? "●" : "└─")</span><strong>@group.Name</strong><span class="badge text-bg-light border me-2">سطح @depth</span></div><div class="small text-muted" style="padding-right:@(depth * 1.5 + 1.5)rem">@GroupPath(group)</div></td><td>@parentName</td><td dir="ltr">@group.Code</td><td>
                        @if (group.VisibleToInternalSales) { <span class="badge text-bg-info ms-1">فروش داخلی</span> }
                        @if (group.VisibleToMarketDistribution) { <span class="badge text-bg-warning ms-1">فروش بازار</span> }
                        @if (!group.VisibleToInternalSales && !group.VisibleToMarketDistribution) { <span class="badge text-bg-secondary">فقط مدیریت</span> }
                    </td></tr>
                }
                @if (groups.Length == 0) { <tr><td colspan="4" class="text-center text-muted py-4">گروهی برای نمایش وجود ندارد.</td></tr> }
                </tbody></table></div>
            </div></div>
        </section>

        @if (canManageSpecifications) {
        <section class="tab-pane fade" id="new-spec"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">تعریف مشخصه برای گروه</h2><form asp-action="CreateSpecification" method="post" class="row g-3">
            <div class="col-md-4"><label class="form-label">گروه</label><select name="productGroupId" class="form-select" required>@foreach (var group in groups) { <option value="@group.Id">@GroupPath(group)</option> }</select></div>
            <div class="col-md-4"><label class="form-label">نام مشخصه</label><input name="name" class="form-control" required /></div><div class="col-md-4"><label class="form-label">کد مشخصه</label><input name="code" class="form-control" dir="ltr" required /></div>
            <div class="col-md-4"><label class="form-label">نوع داده</label><select name="dataType" class="form-select"><option value="0">متن</option><option value="1">عدد اعشاری</option><option value="2">عدد صحیح</option><option value="3">بله / خیر</option><option value="4">لیست انتخابی</option></select></div>
            <div class="col-md-4 d-flex align-items-end"><label class="form-check"><input name="isRequired" value="true" class="form-check-input" type="checkbox" /><span class="form-check-label">مقدار اجباری</span></label></div><div class="col-md-4 d-flex align-items-end"><label class="form-check"><input name="isVariantKey" value="true" class="form-check-input" type="checkbox" /><span class="form-check-label">کلید یکتایی کالا</span></label></div>
            <div class="col-12"><button class="btn btn-primary">ثبت مشخصه</button></div></form></div></div></section>
        <section class="tab-pane fade" id="new-option"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">افزودن گزینه به مشخصه انتخابی</h2><form asp-action="CreateSpecificationOption" method="post" class="row g-3">
            <div class="col-md-6"><label class="form-label">مشخصه از نوع لیست</label><select name="specificationId" class="form-select" required>@foreach (var item in specifications.Where(item => item.DataType == SpecificationDataType.Select)) { <option value="@item.Id">@item.Name — @(groupMap.GetValueOrDefault(item.ProductGroupId)?.Name)</option> }</select></div>
            <div class="col-md-6"><label class="form-label">گزینه</label><input name="value" class="form-control" required /></div><div class="col-12"><button class="btn btn-primary">ثبت گزینه</button></div>
        </form></div></div></section> }

        <section class="tab-pane fade @(!canManageProducts && !canManageGroups ? "show active" : "")" id="catalog-view"></section>
    </div>

    <section class="card border-0 shadow-sm mt-4"><div class="card-body"><h2 class="h5 mb-3">کالاهای قابل نمایش</h2><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>SKU</th><th>نام کالا</th><th>مسیر گروه</th><th>مشخصات</th><th>واحد</th></tr></thead><tbody>
    @foreach (var product in Model.Data.Products.OrderByDescending(product => product.Id)) {
        var values = Model.Data.ProductValues.Where(value => value.ProductId == product.Id).ToArray(); var productGroup = groupMap.GetValueOrDefault(product.ProductGroupId);
        <tr><td dir="ltr">@product.Sku</td><td>@product.Name</td><td>@(productGroup is null ? "—" : GroupPath(productGroup))</td><td>@foreach (var value in values) { var spec = specifications.FirstOrDefault(item => item.Id == value.SpecificationId); var display = spec?.DataType == SpecificationDataType.Select && long.TryParse(value.Value, out var optionId) ? Model.Data.SpecificationOptions.FirstOrDefault(option => option.Id == optionId)?.Value ?? value.Value : value.Value; <span class="badge bg-light text-dark border me-1">@(spec?.Name): @display</span> }</td><td>@product.BaseUnit</td></tr>
    }
    @if (Model.Data.Products.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">کالایی برای نمایش وجود ندارد.</td></tr> }
    </tbody></table></div></div></section>
</div>
@section Scripts { <script src="~/js/catalog-specifications.js" asp-append-version="true"></script> }