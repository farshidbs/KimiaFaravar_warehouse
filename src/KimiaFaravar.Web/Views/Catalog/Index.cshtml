@using KimiaFaravar.Application.Inventory
@model KimiaFaravar.Web.Models.CatalogPageViewModel
@{ ViewData["Title"] = "کاتالوگ محصولات"; }
<div dir="rtl" class="container py-4">
 <div class="d-flex justify-content-between mb-4"><div><h1 class="h3">گروه‌ها، مشخصات و محصولات</h1><p class="text-muted">تعریف ساختار پویای کاتالوگ</p></div><a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary align-self-start">داشبورد</a></div>
 @if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>} @if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
 <div class="row g-3">
  <div class="col-lg-4"><div class="card h-100"><div class="card-header fw-bold">گروه جدید</div><div class="card-body"><form asp-action="CreateGroup" method="post"><label class="form-label">نام</label><input name="name" class="form-control mb-3" required><label class="form-label">کد</label><input name="code" class="form-control mb-3" required><label class="form-label">گروه والد</label><select name="parentId" class="form-select mb-3"><option value="">بدون والد</option>@foreach(var g in Model.Data.Groups){<option value="@g.Id">@g.Name</option>}</select><button class="btn btn-primary w-100">ثبت گروه</button></form></div></div></div>
  <div class="col-lg-4"><div class="card h-100"><div class="card-header fw-bold">مشخصه جدید</div><div class="card-body"><form asp-action="CreateSpecification" method="post"><label class="form-label">گروه</label><select name="productGroupId" class="form-select mb-3" required>@foreach(var g in Model.Data.Groups){<option value="@g.Id">@g.Name</option>}</select><label class="form-label">نام و کد</label><div class="input-group mb-3"><input name="name" class="form-control" placeholder="مثلاً جنس" required><input name="code" class="form-control" placeholder="MATERIAL" required></div><label class="form-label">نوع داده</label><select name="dataType" class="form-select mb-3" asp-items="Html.GetEnumSelectList<SpecificationDataType>()"></select><div class="form-check"><input name="isRequired" value="true" type="checkbox" class="form-check-input"><label class="form-check-label">اجباری</label></div><div class="form-check mb-3"><input name="isVariantKey" value="true" type="checkbox" class="form-check-input"><label class="form-check-label">کلید تنوع محصول</label></div><button class="btn btn-primary w-100">ثبت مشخصه</button></form></div></div></div>
  <div class="col-lg-4"><div class="card h-100"><div class="card-header fw-bold">محصول جدید</div><div class="card-body"><form asp-action="CreateProduct" method="post"><label class="form-label">گروه</label><select name="productGroupId" class="form-select mb-3" required>@foreach(var g in Model.Data.Groups){<option value="@g.Id">@g.Name</option>}</select><label class="form-label">نام</label><input name="name" class="form-control mb-3" required><label class="form-label">SKU</label><input name="sku" class="form-control mb-3" required><label class="form-label">واحد پایه</label><select name="baseUnit" class="form-select mb-3"><option>عدد</option><option>کیلوگرم</option><option>متر</option><option>بسته</option><option>رول</option></select><button class="btn btn-success w-100">ثبت محصول</button></form></div></div></div>
 </div>
 <div class="card mt-4"><div class="card-header fw-bold">ساختار ثبت‌شده</div><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>گروه</th><th>کد</th><th>مشخصات</th><th>محصولات</th></tr></thead><tbody>@foreach(var g in Model.Data.Groups){<tr><td>@g.Name</td><td>@g.Code</td><td>@string.Join("، ",Model.Data.Specifications.Where(x=>x.ProductGroupId==g.Id).Select(x=>x.Name))</td><td>@string.Join("، ",Model.Data.Products.Where(x=>x.ProductGroupId==g.Id).Select(x=>x.Name))</td></tr>}</tbody></table></div></div>
</div>
