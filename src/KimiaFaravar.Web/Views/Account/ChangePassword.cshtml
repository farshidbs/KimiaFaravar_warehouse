@model KimiaFaravar.Web.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "تغییر گذرواژه"; }
<div class="container py-4" dir="rtl"><div class="row justify-content-center"><div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
    <h1 class="h4 mb-2">تغییر گذرواژه حساب من</h1><p class="text-muted mb-4">پس از تغییر موفق، همه نشست‌های قبلی بسته می‌شوند و باید دوباره وارد شوید.</p>
    <form asp-action="ChangePassword" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label">گذرواژه فعلی</label><input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" required /></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label">گذرواژه جدید</label><input asp-for="NewPassword" type="password" class="form-control" minlength="8" autocomplete="new-password" required /><div class="form-text">حداقل ۸ نویسه</div></div>
        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">تکرار گذرواژه جدید</label><input asp-for="ConfirmPassword" type="password" class="form-control" minlength="8" autocomplete="new-password" required /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
        <div class="d-flex gap-2"><button class="btn btn-primary">تغییر گذرواژه</button><a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">انصراف</a></div>
    </form>
</div></div></div></div></div>