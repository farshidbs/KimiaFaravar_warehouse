@model KimiaFaravar.Web.Models.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html><html lang="fa" dir="rtl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#492783" /><title>ورود | کیمیا فرآور</title><link rel="icon" href="~/images/brand/favicon.ico" /><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body class="login-page"><main class="login-shell">
<section class="login-brand-panel"><div class="login-brand-plate"><img src="~/images/brand/logo-horizontal-640.webp" width="640" height="213" alt="کیمیا فرآور صنعت" /></div><div><span class="eyebrow">مدیریت انبار کیمیا فرآور</span><h1>هر کالا، سر جای خود.<br />هر تصمیم، با اطمینان.</h1><p>فضایی یکپارچه برای سامان‌دهی کالاها، پیگیری گردش‌ها و مدیریت روزانه انبار.</p></div><div class="login-panel-footer">کیمیا فرآور صنعت <span>نظم · دقت · اطمینان</span></div></section>
<section class="login-form-panel" aria-labelledby="login-title"><img class="login-emblem" src="~/images/brand/icon-180.png" width="64" height="64" alt="" /><span class="eyebrow">خوش آمدید</span><h2 id="login-title">ورود به فضای کار</h2><p class="text-muted mb-4">برای ادامه، اطلاعات حساب خود را وارد کنید.</p>
@if (TempData["PasswordChanged"] is string changed) { <div class="alert alert-success" role="status">@changed</div> }
<form asp-controller="Account" asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div><input asp-for="ReturnUrl" type="hidden" />
<div class="mb-3"><label asp-for="Username" class="form-label">نام کاربری</label><input asp-for="Username" class="form-control" autocomplete="username" dir="ltr" autofocus /><span asp-validation-for="Username" class="text-danger small"></span></div>
<div class="mb-4"><label asp-for="Password" class="form-label">رمز عبور</label><input asp-for="Password" class="form-control" autocomplete="current-password" dir="ltr" /><span asp-validation-for="Password" class="text-danger small"></span></div><button class="btn btn-primary btn-lg w-100">ورود به سامانه</button></form><p class="login-help">برای دریافت دسترسی با مدیر سامانه تماس بگیرید.</p></section>
</main></body></html>
