@using KimiaFaravar.Application.Inventory
@model KimiaFaravar.Web.Models.InventoryPageViewModel
@{ ViewData["Title"] = "عملیات انبار"; }
<div dir="rtl" class="container py-4">
 <div class="d-flex justify-content-between mb-4"><div><h1 class="h3">ورود و خروج کالا</h1><p class="text-muted">ثبت سریع عملیات و مشاهده موجودی لحظه‌ای</p></div><a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary align-self-start">مدیریت محصولات</a></div>
 @if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>} @if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
 <div class="row g-3 mb-4">
  <div class="col-lg-6"><div class="card border-success"><div class="card-header bg-success-subtle fw-bold">ورود کالا</div><div class="card-body"><form asp-action="Receipt" method="post"><label class="form-label">محصول</label><select name="productId" class="form-select form-select-lg mb-3" required>@foreach(var p in Model.Data.Products){<option value="@p.Id">@p.Name — @p.Sku</option>}</select><div class="row"><div class="col-5"><label class="form-label">مقدار</label><input name="quantity" type="number" min="0.001" step="0.001" class="form-control form-control-lg" required></div><div class="col-7"><label class="form-label">شرح</label><input name="reason" class="form-control form-control-lg"></div></div><button class="btn btn-success btn-lg w-100 mt-3">ثبت ورود</button></form></div></div></div>
  <div class="col-lg-6"><div class="card border-danger"><div class="card-header bg-danger-subtle fw-bold">خروج کالا</div><div class="card-body"><form asp-action="Dispatch" method="post"><label class="form-label">محصول</label><select name="productId" class="form-select form-select-lg mb-3" required>@foreach(var p in Model.Data.Products){<option value="@p.Id">@p.Name — موجودی @p.Quantity @p.BaseUnit</option>}</select><div class="row"><div class="col-5"><label class="form-label">مقدار</label><input name="quantity" type="number" min="0.001" step="0.001" class="form-control form-control-lg" required></div><div class="col-7"><label class="form-label">دلیل خروج</label><input name="reason" class="form-control form-control-lg" required></div></div><button class="btn btn-danger btn-lg w-100 mt-3">ثبت خروج</button></form></div></div></div>
 </div>
 <div class="card mb-4"><div class="card-header fw-bold">موجودی فعلی</div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>SKU</th><th>محصول</th><th>موجودی</th><th>واحد</th></tr></thead><tbody>@foreach(var p in Model.Data.Products){<tr><td>@p.Sku</td><td>@p.Name</td><td class="fw-bold">@p.Quantity</td><td>@p.BaseUnit</td></tr>}</tbody></table></div></div>
 <div class="card"><div class="card-header fw-bold">آخرین گردش‌ها</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>زمان</th><th>نوع</th><th>محصول</th><th>مقدار</th><th>شرح</th></tr></thead><tbody>@foreach(var m in Model.Data.Movements.Take(30)){<tr><td>@m.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td><span class="badge @(m.Type==MovementType.Receipt?"text-bg-success":"text-bg-danger")">@(m.Type==MovementType.Receipt?"ورود":"خروج")</span></td><td>@m.ProductName</td><td>@m.Quantity @m.Unit</td><td>@m.Reason</td></tr>}</tbody></table></div></div>
</div>
