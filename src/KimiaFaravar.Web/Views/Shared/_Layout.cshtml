<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | انبارداری کیمیا فرآور</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KimiaFaravar.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header border-bottom bg-white">
        <nav class="navbar navbar-expand-lg navbar-light container py-3">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">کیمیا فرآور <span class="text-muted fs-6 fw-normal">| انبارداری</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#app-menu" aria-controls="app-menu" aria-expanded="false" aria-label="نمایش منو">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="app-menu">
                <ul class="navbar-nav me-auto gap-lg-2">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">داشبورد</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Inventory" asp-action="Index">موجودی و گردش کالا</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Catalog" asp-action="Index">تعریف کالا</a></li>
                </ul>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex mt-2 mt-lg-0"><button class="btn btn-outline-secondary btn-sm">خروج</button></form>
                }
            </div>
        </nav>
    </header>
    <main class="container pb-5" role="main">@RenderBody()</main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
