@using System.Security.Claims
@{ ViewData["Title"] = "داشبورد"; var permissions = User.FindAll("permission").Select(x => x.Value).OrderBy(x => x).ToList(); }
<div dir="rtl" class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">داشبورد انبار کیمیا فرآور</h1><div class="text-muted">نسخه اولیه فاز هویت و دسترسی</div></div>
    <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-danger">خروج</button></form>
  </div>
  <div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted">کاربر</div><div class="fs-4">@User.Identity?.Name</div></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted">نقش</div><div class="fs-4">@User.FindFirstValue(ClaimTypes.Role)</div></div></div></div>
    <div class="col-md-4"><div class="card h-100 border-primary"><div class="card-body"><div class="text-muted">منبع داده فعال</div><div class="fs-4 text-primary">@ViewBag.StorageProvider</div></div></div></div>
  </div>
  <div class="card"><div class="card-header fw-bold">مجوزهای فعال (@permissions.Count)</div><div class="card-body d-flex flex-wrap gap-2">@foreach(var permission in permissions){<span class="badge text-bg-secondary p-2">@permission</span>}</div></div>
  <div class="mt-4 d-flex flex-wrap gap-2"><a asp-controller="Catalog" asp-action="Index" class="btn btn-success btn-lg">گروه‌ها و محصولات</a><a asp-controller="Inventory" asp-action="Index" class="btn btn-danger btn-lg">ورود و خروج کالا</a><a asp-controller="AccessControl" asp-action="Index" class="btn btn-outline-primary btn-lg">نقش‌ها و مجوزها</a></div>
</div>
